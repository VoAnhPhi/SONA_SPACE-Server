<div class="error-state">
  <p class="error-state__code"><%= (error && error.status) || 500 %></p>
  <h1 class="dashboard-title"><%= message %></h1>
  <a class="btn btn-save" href="/dashboard">Về trang tổng quan</a>
  <% if (error && error.stack) { %>
  <pre class="error-state__stack"><%= error.stack %></pre>
  <% } %>
</div>

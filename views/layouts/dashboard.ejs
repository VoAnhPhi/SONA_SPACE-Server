              </a>
            </li>
            <li class="nav-item">
              <a href="/dashboard/voucher">
                <i class="fa-solid fa-ticket" aria-hidden="true"></i>
                <span>Voucher</span>
              </a>
            </li>
            <li class="nav-item">
              <a href="/dashboard/events">
                <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                <span>Sự kiện</span>
              </a>
            </li>
          </ul>
        </div>
        <div class="menu-section">
          <div class="menu-section-title">Sản phẩm</div>
          <ul class="nav-menu">
            <li class="nav-item">
              <a href="/dashboard/products">
                <i class="fa-solid fa-couch" aria-hidden="true"></i>
                <span>Sản phẩm</span>
              </a>
            </li>
            <li class="nav-item">
              <a href="/dashboard/categories">
                <i class="fa-solid fa-table-list" aria-hidden="true"></i>
                <span>Danh mục</span>
              </a>
            </li>
            <li class="nav-item">
              <a href="/dashboard/room">
                <i class="fa-solid fa-house" aria-hidden="true"></i>
                <span>Không gian</span>
              </a>
            </li>
            <li class="nav-item">
              <a href="/dashboard/colors">
                <i class="fa-solid fa-palette" aria-hidden="true"></i>
                <span>Màu sắc</span>
              </a>
            </li>
            <li class="nav-item">
              <a href="/dashboard/material">
                <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                <span>Vật liệu</span>
              </a>
            </li>
            <li class="nav-item">
              <a href="/dashboard/comment">
                <i class="fa-regular fa-comments" aria-hidden="true"></i>
                <span>Bình luận</span>
              </a>
            </li>
          </ul>
        </div>
        <div class="menu-section">
          <div class="menu-section-title">Nội dung</div>
          <ul class="nav-menu">
            <li class="nav-item">
              <a href="/dashboard/banners">
                <i class="fa-regular fa-images" aria-hidden="true"></i>

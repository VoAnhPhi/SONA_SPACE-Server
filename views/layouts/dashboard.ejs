      <div class="sidebar-user">
        <button type="button" class="user-profile" id="user-profile" aria-haspopup="menu" aria-expanded="false">
          <span class="avatar" id="user-avatar" aria-hidden="true"></span>
          <span class="user-info">
            <span class="user-name">Quản trị viên</span>
            <span class="user-role"></span>
          </span>
          <i class="fa-solid fa-chevron-up dropdown-arrow" aria-hidden="true"></i>
        </button>
        <ul class="user-menu" id="user-menu" role="menu" hidden>
          <li role="none"><a role="menuitem" href="/dashboard/profile"><i class="fa-regular fa-circle-user" aria-hidden="true"></i>Hồ sơ</a></li>
          <li role="none"><a role="menuitem" href="#" id="logout-btn"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>Đăng xuất</a></li>
        </ul>
      </div>
    </aside>
    <div class="sidebar-backdrop" id="sidebar-backdrop" hidden></div>
    <div class="main-content">
      <header class="dashboard-header">
        <div class="header-left">
          <button type="button" class="sidebar-toggle" id="sidebar-toggle" aria-label="Mở menu" aria-controls="sidebar" aria-expanded="false">
            <i class="fa-solid fa-bars" aria-hidden="true"></i>
          </button>
          <nav class="page-crumb" id="page-crumb" aria-label="Vị trí trang"></nav>
        </div>
        <div class="header-right">
          <div class="notifications dropdown">
            <button type="button" class="notifications-toggle" id="notification-toggle" aria-label="Thông báo đơn hàng hôm nay">
              <i class="fa-regular fa-bell" aria-hidden="true"></i>
              <span id="notification-count" class="notification-count" style="display: none">0</span>
            </button>
            <div id="notification-dropdown" class="dropdown-menu notifications-dropdown">
              <div class="dropdown-header">Thông báo</div>
              <div class="notification-list" id="notification-list">
                <!-- Thông báo sẽ được thêm động vào đây -->
              </div>
              <div class="dropdown-footer">
                <a href="/dashboard/notify">Xem tất cả</a>
              </div>
            </div>
          </div>
        </div>
      </header>

      <div class="content-container"><%- body %></div>
    </div>
    <!-- Bootstrap JS Bundle with Popper -->
    <%- script %>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
      <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
      <script src="/javascripts/dashboard.js"></script>
      <script>
        // Kiểm tra xác thực khi tải trang dashboard
        document.addEventListener("DOMContentLoaded", function () {
          // Kiểm tra token và thông tin người dùng
          const token = localStorage.getItem("token");
          const user = JSON.parse(localStorage.getItem("user") || "{}");

          // Nếu không có token hoặc không phải admin, chuyển hướng về trang đăng nhập
          const allowedRoles = ['admin', 'staff'];
          if (!token || !user || !allowedRoles.includes(user.role)) {
            window.location.href = '/';
            return;
          }

          // Show the signed-in user in the sidebar footer
          const roleMap = { admin: "Quản trị viên", staff: "Nhân viên" };
          const displayName = user.full_name || roleMap[user.role] || "Tài khoản";
          document.querySelector(".user-name").textContent = displayName;
          document.querySelector(".user-role").textContent = roleMap[user.role] || user.role;
          // Initials instead of a third-party stock photo
          document.getElementById("user-avatar").textContent = displayName
            .split(/\s+/)
            .filter(Boolean)
            .slice(-2)
            .map((word) => word[0].toUpperCase())
            .join("");

          // Account menu (profile, sign out) opens upward from the sidebar footer
          const userProfile = document.getElementById("user-profile");
          const userMenu = document.getElementById("user-menu");
          const setUserMenu = (open) => {
            userMenu.hidden = !open;
            userProfile.setAttribute("aria-expanded", String(open));
          };
          userProfile.addEventListener("click", () => setUserMenu(userMenu.hidden));
          document.addEventListener("click", (event) => {
            if (!userProfile.contains(event.target) && !userMenu.contains(event.target)) setUserMenu(false);
          });
          document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") setUserMenu(false);
          });

          document.getElementById("logout-btn").addEventListener("click", async (event) => {
            event.preventDefault();
            try {
              // Revoke the token server-side before clearing it locally
              await fetch("/api/auth/logout", {
                method: "POST",
                headers: { Authorization: `Bearer ${token}` },
              });
            } catch (error) {
              console.error("Logout error:", error);
            } finally {
              localStorage.removeItem("token");
              localStorage.removeItem("user");
              window.location.href = "/";
            }
          });

          // Pending orders next to "Đơn hàng"; staff accounts may not reach this admin-only endpoint
          fetch("/api/orders/status/count", { headers: { Authorization: `Bearer ${token}` } })
            .then((response) => (response.ok ? response.json() : []))
            .then((statuses) => {
              const pending = (statuses || []).find((item) => item.status === "PENDING");
              const badge = document.getElementById("nav-pending-count");
              if (pending && pending.count > 0) {
                badge.textContent = pending.count;
                badge.title = `${pending.count} đơn chờ xác nhận`;
                badge.hidden = false;
              }
            })
            .catch(() => {});
        });
      </script>
      <script>
        document.addEventListener("DOMContentLoaded", function () {
          const toggle = document.getElementById("notification-toggle");
          const dropdown = document.getElementById("notification-dropdown");
          const listContainer = document.getElementById("notification-list");
          // Gọi API lấy thông báo khi vừa load trang
          (async () => {
            try {
              const token = localStorage.getItem("token");
              const response = await fetch("/api/notify/admin", {
                headers: {
                  Authorization: `Bearer ${token}`,
                },
              });

              const allNotifications = await response.json();
              const today = new Date().toLocaleDateString('vi-VN'); 
              const todayNotifications = allNotifications.filter((noti) => {
                const notiDate = new Date(noti.created_at).toLocaleDateString('vi-VN');
                const isToday = notiDate === today;
                const isOrderType = Number(noti.type_id) === 15;
                // 
                return isOrderType && isToday;
              });
              // 
              const countElement = document.getElementById("notification-count");
              countElement.textContent = todayNotifications.length;
              countElement.style.display = todayNotifications.length > 0 ? "inline-block" : "none";
            } catch (err) {
            }
          })();

          toggle.addEventListener("click", async () => {
            dropdown.classList.toggle("show");

            if (dropdown.classList.contains("show")) {
              try {
                const token = localStorage.getItem("token");

                const response = await fetch("/api/notify/admin", {
                  headers: {
                    Authorization: `Bearer ${token}`,
                  },
                });

                // 

                if (response.ok) {
                  const allNotifications = await response.json(); 

                  // 
                  listContainer.innerHTML = "";

                  const today = new Date().toLocaleDateString('vi-VN');

                  // Lọc thông báo hôm nay có type là "order"
                  const todayNotifications = allNotifications.filter((noti) => {
                    const notiDate = new Date(noti.created_at).toLocaleDateString('vi-VN');
                    const isToday = notiDate === today;
                    const isOrderType = Number(noti.type_id) === 15;
                    return isOrderType && isToday;
                  });

                  // Cập nhật số lượng hiển thị
                  const countElement = document.getElementById("notification-count");
                  countElement.textContent = todayNotifications.length;
                  countElement.style.display = todayNotifications.length > 0 ? "inline-block" : "none";

                  if (todayNotifications.length > 0) {
                    todayNotifications.forEach((noti) => {
                      const item = document.createElement("div");
                      item.className = "notification-item";
                      item.innerHTML = `
            <div class="icon"><i class="fas fa-bell"></i></div>
            <div class="content">
              <div class="title"></div>
              <div class="time">${formatTimeAgo(noti.created_at)}</div>
            </div>
          `;
                      // The message is stored text; never parse it as markup
                      item.querySelector(".title").textContent = noti.message;
                      listContainer.appendChild(item);
                    });
                  } else {
                    listContainer.innerHTML = '<div class="p-3 text-center text-muted">Không có thông báo nào.</div>';
                  }
                } else {
                }
              } catch (err) {
              }
            }

          });

          // Ẩn dropdown khi click ra ngoài
          document.addEventListener("click", function (e) {
            if (!dropdown.contains(e.target) && !toggle.contains(e.target)) {
              dropdown.classList.remove("show");
            }
          });

          // Hàm định dạng thời gian đơn giản
          function formatTimeAgo(dateString) {
            const date = new Date(dateString);
            const now = new Date();
            const diff = Math.floor((now - date) / 1000); // in seconds

            if (diff < 60) return "Vừa xong";
            else if (diff < 3600) return `${Math.floor(diff / 60)} phút trước`;
            else if (diff < 86400) return `${Math.floor(diff / 3600)} giờ trước`;
            else return `${Math.floor(diff / 86400)} ngày trước`;
          }
        });

      </script>
</body>

</html>